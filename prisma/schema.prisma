generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id String @id @default(cuid())

  type Type

  images      String[]
  title       String
  price       Float
  description String
  colors      String[]
  sizes       String[]
  gender      Gender?
  category    Category
  material    String
  fit         String
  care        String
  origin      String

  slug String @unique

  createdAt DateTime @default(now())
}

enum Type {
  APPAREL
  ACCESSORIES
  NUTRITION
}

enum Gender {
  MEN
  WOMEN
}

enum Category {
  TSHIRT
  TANK
  HOODIE
  SWEATSHIRT
  JOGGERS
  SHORTS
  COMPRESSION
  LEGGINGS
  OUTERWEAR
  SEAMLESS
  OVERSIZE
  TRAINING
  RUNNING
  POWERLIFTING
  CROSSFIT
  RECOVERY
  SPORT_BRA
  CROP
  HIGHWAIST
  GYM_SET
  YOGA
  BAG
  GLOVES
  STRAPS
  WRAPS
  BELT
  SHAKER
  BOTTLE
  CAP
  BEANIE
  TOWEL
  WATCH
  SOCKS
  KNEE_SLEEVES
  WRIST_SLEEVES
  BACKPACK
  ESSENTIAL
  PROTEIN
  WHEY
  ISOLATE
  CASEIN
  BCAA
  EAA
  PREWORKOUT
  FATBURNER
  VITAMINS
  TESTOSTERONE
  CREATINE
  ENERGY
  WEIGHT_GAINER
  SHRED
  HEALTH
  SUPPLEMENT
}

model User {
  id String @id @default(cuid())

  email    String @unique
  password String
  role     Role   @default(USER)

  avatar    String
  firstName String
  lastName  String

  address String?

  paymentMethod String?

  slug String @unique
}

enum Role {
  USER
  ADMIN
}
